# ==============================================================================
# MeetingMind Production Environment Configuration Template
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL PRODUCTION SECRETS TO VERSION CONTROL.
# Fill in the variables below when provisioning your production environment.

# ------------------------------------------------------------------------------
# Application Environment & Server
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PORT=8000
PROJECT_NAME="MeetingMind API"
VERSION=1.0.0
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------------------
# PostgreSQL Database (Supabase / RDS / Neon)
# Must support SSL / connection pooling for high availability
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:[YOUR-STRONG-PASSWORD]@[YOUR-DB-HOST]:5432/[YOUR-DB-NAME]?sslmode=require

# ------------------------------------------------------------------------------
# Redis Cache & Job Queue (Upstash / Redis Cloud / Self-Hosted)
# ------------------------------------------------------------------------------
REDIS_URL=redis://:[YOUR-REDIS-PASSWORD]@[YOUR-REDIS-HOST]:6379/0

# ------------------------------------------------------------------------------
# AI Services API Keys
# ------------------------------------------------------------------------------
# DeepGram API key for Nova-3 Speech-to-Text and Diarization
DEEPGRAM_API_KEY=your_production_deepgram_api_key_here

# Google Gemini API key for Meeting Insights & Q&A (gemini-2.5-flash)
GEMINI_API_KEY=your_production_gemini_api_key_here

# ------------------------------------------------------------------------------
# Cloud Storage (AWS S3 / Cloudflare R2 / MinIO)
# ------------------------------------------------------------------------------
STORAGE_DRIVER=s3
S3_BUCKET_NAME=meetingmind-production-uploads
S3_REGION=us-east-1
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=your_production_s3_access_key
S3_SECRET_KEY=your_production_s3_secret_key
LOCAL_STORAGE_PATH=storage_uploads

# ------------------------------------------------------------------------------
# Security & JWT Authentication
# Must be an unpredictable, random string of at least 64 hex characters
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=generate_strong_random_secret_at_least_64_characters_long_for_production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# CORS & Web Origins Whitelist
# ------------------------------------------------------------------------------
FRONTEND_URL=https://app.meetingmind.ai
PRODUCTION_FRONTEND_URL=https://app.meetingmind.ai

# ------------------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------------------
GENERAL_RATE_LIMIT=100/minute
AI_RATE_LIMIT=10/minute
